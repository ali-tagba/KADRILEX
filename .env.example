# =============================================================================
# KadriLex — Variables d'environnement
# =============================================================================
# Setup :
#   1. Copier ce fichier vers .env.local
#   2. Remplir les valeurs (récupérables sur le VPS dev :
#        ssh root@82.25.116.169 'cat /root/kadrilex-supabase-secrets.txt')
#   3. Lancer le tunnel : npm run db:tunnel  (avant npm run dev)
# =============================================================================

# === Postgres (via SSH tunnel local 5433 -> VPS supabase-db direct) ===
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5433/postgres

# === Supabase API publique ===
NEXT_PUBLIC_SUPABASE_URL=https://supabase.82.25.116.169.sslip.io
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY JWT>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY JWT — jamais en NEXT_PUBLIC_>

# === Démo front-end ===
# Mettre à 0 seulement pour forcer le mode réel en production.
NEXT_PUBLIC_DEMO_MODE=1

# === Studio admin ===
# URL : https://supabase.82.25.116.169.sslip.io
# Login : admin / <DASHBOARD_PASSWORD>
