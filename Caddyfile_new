82-25-116-169.nip.io {
    @fanakaRoot path /fanaka /fanaka/
    redir @fanakaRoot /fanaka/prototype/ 302

    handle_path /fanaka/* {
        encode gzip zstd
        root * /var/www/fanaka
        file_server

        @assets path *.css *.js *.mp4 *.webm *.jpg *.jpeg *.png *.webp *.svg *.woff *.woff2
        header @assets Cache-Control "public, max-age=2592000, immutable"

        @html path *.html
        header @html Cache-Control "no-store, must-revalidate"

        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "strict-origin-when-cross-origin"
            -Server
        }
    }

    handle {
        reverse_proxy 127.0.0.1:8080
    }

    log {
        output file /var/log/caddy/fanaka-access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}
