  COLLABORATEUR_CDI
  COLLABORATEUR_CDD
  STAGIAIRE
  SECRETAIRE_CDI
  FREELANCE
}

enum ClientType {
  PERSONNE_MORALE
  PERSONNE_PHYSIQUE
}

enum DossierKind {
